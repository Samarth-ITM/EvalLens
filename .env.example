# EvalLens Environment Configuration
# Copy this file to .env to customize local settings.
# Note: You can also configure your Gemini API Key directly inside the EvalLens Settings UI.

# Google Gemini API Key (Optional environment fallback; BYOK can be entered in Settings UI)
GEMINI_API_KEY=

# Default Gemini Model (Options: gemini-3.8-flash, gemini-3.5-flash-lite, gemini-4-argon)
GEMINI_MODEL=gemini-3.8-flash

# Environment (development / production)
EVALLENS_ENV=development

# Database path (relative to project root or absolute path)
DB_PATH=data/evallens.db

