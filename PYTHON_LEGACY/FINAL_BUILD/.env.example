# ==============================================================================
# EvalLens - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize the values for your deployment.
# Never commit your actual .env file or credentials to source control.

# ------------------------------------------------------------------------------
# 1. Environment Mode
# ------------------------------------------------------------------------------
# Set to 'development' for local testing, or 'production' / 'render' for hosted testing.
# When set to 'production' or 'render', EVALLENS_ACCESS_PASSWORD MUST be explicitly configured.
EVALLENS_ENV=development

# ------------------------------------------------------------------------------
# 2. Access Protection (5-Person Shared Prototype)
# ------------------------------------------------------------------------------
# In 'development', defaults to 'evallens2026' if left empty.
# In 'production' / 'render', you MUST change this to a strong custom passkey.
# NOTICE: All 5 testers access a shared workspace where evaluations and rubrics are visible.
EVALLENS_ACCESS_PASSWORD=evallens2026

# ------------------------------------------------------------------------------
# 3. Google Gemini API Key (Bring Your Own Key)
# ------------------------------------------------------------------------------
# Provide your Gemini API key here or enter it inside the application via Settings -> AI Configuration.
# The key is held strictly in session memory and is never written to disk or the database.
GEMINI_API_KEY=

# Default Gemini model
# Recommended: gemini-3.5-flash-lite (fastest and most cost-effective text model)
# Other supported models: gemini-3.8-flash, gemini-4-argon
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 4. Storage & Persistence Configuration
# ------------------------------------------------------------------------------
# Default paths resolve locally to data/evallens.db and uploads/.
# For Render or Docker persistent volume mounts, specify absolute paths:
# DB_PATH=/var/data/evallens.db
# UPLOADS_PATH=/var/data/uploads

# ------------------------------------------------------------------------------
# 5. Server Networking
# ------------------------------------------------------------------------------
# Port to bind Streamlit server (Render automatically sets $PORT)
PORT=8501

